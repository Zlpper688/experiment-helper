{
  "manifest_version": 3,
  "name": "实验选课助手",
  "version": "0.7.0",
  "description": "实验筛选、课表/实验间冲突检测、一键预约（响应验证）、自动抢课（必做优先、跳过不想选）、必做标记、同类去重、已做实验自动同步（成绩查询页）、选课进度（AI/BI需求）、不想选标记、老师筛选、每行状态徽标（含测试状态）、加载失败提示、节次码搜索、新人交接检查（列表周次 + 已预约/已做实验自动同步确认）。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://wlsy.webvpn.sau.edu.cn/lab2026/index.php*"],
      "js": ["shared.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
